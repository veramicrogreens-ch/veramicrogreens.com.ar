---
import { siteConfig } from '../site.config';
---
<footer id="contacto" class="border-t border-[var(--line)]">
  <div class="container flex flex-col gap-8 py-10 text-xs md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-bold tracking-[0.08em]">VERA MICROGREENS</p>
      <p class="mt-2 text-neutral-500">Microgreens decorativos para gastronomía.</p>
    </div>
    <div class="flex flex-wrap gap-5 text-neutral-600">
      {siteConfig.instagram && <a href={siteConfig.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>}
      {siteConfig.facebook && <a href={siteConfig.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>}
      <a href={siteConfig.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </div>
  <div class="container border-t border-[var(--line)] py-5 text-[0.65rem] uppercase tracking-[0.1em] text-neutral-400">
    © {new Date().getFullYear()} Vera Microgreens · Buenos Aires, Argentina
  </div>
</footer>
