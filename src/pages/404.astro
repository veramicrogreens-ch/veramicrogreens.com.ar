---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Vera Microgreens" description="Página no encontrada.">
  <main class="container grid min-h-screen place-items-center py-20 text-center">
    <div>
      <p class="eyebrow">404</p>
      <h1 class="mt-4 text-4xl">Esta página no existe.</h1>
      <a href="/" class="mt-8 inline-block border border-black px-5 py-3 text-xs uppercase tracking-[0.12em]">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>
