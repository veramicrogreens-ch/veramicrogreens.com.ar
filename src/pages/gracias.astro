---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Gracias — Vera Microgreens" description="Gracias por contactar a Vera Microgreens.">
  <main class="container grid min-h-screen place-items-center py-20 text-center">
    <div>
      <p class="eyebrow">Vera Microgreens</p>
      <h1 class="mt-5 text-4xl">Gracias.</h1>
      <p class="mx-auto mt-5 max-w-md text-neutral-600">Tu consulta fue recibida.</p>
      <a href="/" class="mt-8 inline-block border border-black px-5 py-3 text-xs uppercase tracking-[0.12em]">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>
