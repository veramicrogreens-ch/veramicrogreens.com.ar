---
import { siteConfig } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Microgreens from '../components/Microgreens.astro';
import WhyVera from '../components/WhyVera.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Vera Microgreens — Microgreens para gastronomía" description={siteConfig.description}>
  <Header />
  <main>
    <Hero />
    <Microgreens />
    <WhyVera />
  </main>
  <Footer />

  <a
    href={siteConfig.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar a Vera Microgreens por WhatsApp"
    class="fixed bottom-5 right-5 z-50 grid h-14 w-14 place-items-center rounded-full bg-[#258b45] text-white shadow-lg transition-transform hover:scale-105 hover:bg-[#1f783b]"
  >
    <span aria-hidden="true" class="font-mono text-[15px] font-bold tracking-[-0.08em]">VM</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="hidden">
      <path d="M20.5 3.5A11.82 11.82 0 0 0 12.08 0C5.55 0 .24 5.3.24 11.83c0 2.08.54 4.11 1.57 5.9L.13 24l6.42-1.68a11.8 11.8 0 0 0 5.53 1.4h.01c6.52 0 11.83-5.31 11.83-11.83 0-3.16-1.23-6.13-3.42-8.39Zm-8.42 18.2h-.01a9.83 9.83 0 0 1-5.01-1.37l-.36-.21-3.81 1 1.02-3.71-.24-.38a9.82 9.82 0 1 1 8.41 4.67Zm5.39-7.37c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.28-.47-2.43-1.5-.9-.8-1.5-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.08 4.5.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
    </svg>
  </a>
</BaseLayout>
